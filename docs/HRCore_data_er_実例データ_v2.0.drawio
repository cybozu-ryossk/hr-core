  <diagram id="hrcore-sample-tree" name="1. 組織ツリー">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
