        <mxCell id="T-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="T-00" target="T-01"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e0b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="T-00" target="T-04"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e0c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="T-00" target="T-07"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="T-01" target="T-02"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="T-02" target="T-03"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="T-04" target="T-05"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#757575;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="T-05" target="T-06"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e5" value="会社跨ぎ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#F57C00;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#E65100;" edge="1" parent="1" source="T-07" target="T-08"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="T-e6" value="2026-10-01 から" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#8E24AA;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#6A1B9A;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="T-07" target="T-02"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="T-00" value="&lt;b&gt;サイボウズ株式会社&lt;/b&gt;　CB-ROOT&lt;br&gt;&lt;b&gt;company(0)&lt;/b&gt; / depth 1　is_countable=&lt;b&gt;false&lt;/b&gt;&lt;br&gt;&lt;i&gt;役員設置用の器。階層集計から除外&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;fontColor=#333333;fillColor=#FFFDE7;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="290" height="64" as="geometry" /></mxCell>

        <mxCell id="T-01" value="&lt;b&gt;人事本部&lt;/b&gt;　HR&lt;br&gt;honbu(1) / depth 2　CB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="90" y="195" width="210" height="52" as="geometry" /></mxCell>
        <mxCell id="T-02" value="&lt;b&gt;人事インフラ部&lt;/b&gt;　HRINF&lt;br&gt;&lt;b&gt;bu(3)&lt;/b&gt; / depth 3　⚠歯抜け　CB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="210" height="52" as="geometry" /></mxCell>
        <mxCell id="T-03" value="&lt;b&gt;HR数値分析チーム&lt;/b&gt;　HRANL&lt;br&gt;&lt;b&gt;team(5)&lt;/b&gt; / depth 4　⚠歯抜け　CB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="90" y="385" width="210" height="52" as="geometry" /></mxCell>

        <mxCell id="T-04" value="&lt;b&gt;EP事業本部&lt;/b&gt;　EP&lt;br&gt;honbu(1) / depth 2　CB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="390" y="195" width="210" height="52" as="geometry" /></mxCell>
        <mxCell id="T-05" value="&lt;b&gt;EP事業副部&lt;/b&gt;　EPF&lt;br&gt;fuku_honbu(2) / depth 3　CB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="390" y="290" width="210" height="52" as="geometry" /></mxCell>
        <mxCell id="T-06" value="&lt;b&gt;EP事業部&lt;/b&gt;　EPB&lt;br&gt;&lt;b&gt;bu(3)&lt;/b&gt; / depth 4　歯抜けなし　CB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;strokeColor=#43A047;fillColor=#E8F5E9;" vertex="1" parent="1"><mxGeometry x="390" y="385" width="210" height="52" as="geometry" /></mxCell>

        <mxCell id="T-07" value="&lt;b&gt;グローバル事業本部&lt;/b&gt;　GLB&lt;br&gt;honbu(1) / depth 2　CB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;" vertex="1" parent="1"><mxGeometry x="690" y="195" width="220" height="52" as="geometry" /></mxCell>
        <mxCell id="T-08" value="&lt;b&gt;Cybozu US&lt;/b&gt;　USOPS&lt;br&gt;&lt;b&gt;bu(3)&lt;/b&gt; / depth 3　⚠歯抜け　&lt;b&gt;CBUS&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#FFF8E1;strokeColor=#FFB300;" vertex="1" parent="1"><mxGeometry x="690" y="290" width="220" height="52" as="geometry" /></mxCell>

        <mxCell id="T-09" value="&lt;b&gt;Cybozu US, Inc.&lt;/b&gt;　CBUS-ROOT&lt;br&gt;&lt;b&gt;company(0)&lt;/b&gt; / depth 1　&lt;b&gt;CBUS&lt;/b&gt;&lt;br&gt;&lt;i&gt;配下を持たない独立ルート。&lt;br&gt;US の組織は GLB 配下にあるため&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;fontColor=#333333;fillColor=#FFFDE7;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="250" height="74" as="geometry" /></mxCell>
        <mxCell id="T-10" value="&lt;b&gt;Cybozu Vietnam&lt;/b&gt;　VNOPS&lt;br&gt;honbu(1) / depth 1　&lt;b&gt;CBVN&lt;/b&gt;&lt;br&gt;&lt;i&gt;独立ルート（会社相当組織は未作成）&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;fontColor=#333333;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="990" y="195" width="250" height="64" as="geometry" /></mxCell>

        <mxCell id="T-wg" value="&lt;b&gt;階層に属さない横断軸&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;職能（job_function）&lt;/b&gt;&lt;br&gt;　FE フロントエンドエンジニア&lt;br&gt;　BE バックエンドエンジニア&lt;br&gt;　QA QAエンジニア&lt;br&gt;　PDM PDマネジメント&lt;br&gt;&lt;br&gt;&lt;b&gt;ワーキンググループ（working_group）&lt;/b&gt;&lt;br&gt;　WG-DEI DEI推進WG（全社）&lt;br&gt;　WG-AI 生成AI活用WG（技術）&lt;br&gt;&lt;br&gt;&lt;i&gt;どちらもツリーに乗らない。1人が複数持てる&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fontColor=#333333;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="990" y="290" width="250" height="215" as="geometry" />
        </mxCell>

        <mxCell id="T-note" value="&lt;b&gt;この1枚で分かること&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;会社相当組織（黄）&lt;/b&gt;　役員の役職を設置するための器。layer_order = 0 で is_countable = false なので、&lt;br&gt;　　「本部レベルの人員数」を数えても混入しない。これがないと position.org_code が NOT NULL のため役員を表現できない&lt;br&gt;&lt;br&gt;⚠ &lt;b&gt;歯抜け&lt;/b&gt;　人事本部(1) の直下が部(3)。副本部(2) が存在しない。制約トリガは layer_order の単調増加だけを見るので通る&lt;br&gt;&lt;br&gt;&lt;b&gt;depth と階層区分がずれる&lt;/b&gt;　HRINF は depth 3 だが「部」（3段目）。EPB は depth 4 で「部」。→ depth で「部レベル」を数えると破綻する&lt;br&gt;　　※ 会社相当組織を挟んだため、v2.0 の図より depth が 1 増えている（階層区分の段数は変わらない）&lt;br&gt;&lt;br&gt;&lt;b&gt;フォレスト構造&lt;/b&gt;　ルートは CB-ROOT / CBUS-ROOT / VNOPS の3つ。CBUS-ROOT は配下を持たない（US の組織は GLB 配下にあるため）&lt;br&gt;&lt;br&gt;&lt;b&gt;会社跨ぎ&lt;/b&gt;　GLB(CB) の配下に USOPS(CBUS)。会社別集計と階層集計が別軸になる&lt;br&gt;&lt;br&gt;&lt;b&gt;未来日の組織再編（紫の破線）&lt;/b&gt;　2026-10-01 に HRINF の親が HR → GLB に変わる。登録済みで、基準日が到達すれば自動的に切り替わる" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#333333;fillColor=#FAFAFA;strokeColor=#B0BEC5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="1180" height="250" as="geometry" />
        </mxCell>

        <mxCell id="t-note2" value="&lt;b&gt;Scope&lt;/b&gt;：ER図（HRCore_data_er_全体_v3.0.drawio）の理解を補助するダミーデータ。実データではない。会社名・組織名・氏名・社員番号はすべて仮のもの。　　&lt;b&gt;他のページ&lt;/b&gt;：2. サンプルレコード（人）／3. サンプルレコード（組織・横断）／4. as-of・集計軸　　v3.0" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;" vertex="1" parent="1">
          <mxGeometry x="60" y="795" width="1180" height="45" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hrcore-sample-person-v3" name="2. サンプルレコード（人）">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p-title" value="HRCore 実例データ — ② サンプルレコード（人・雇用・在籍状況・労働条件）" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A2538;" vertex="1" parent="1">
          <mxGeometry x="400" y="14" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-sub" value="期間はすべて半開区間 [) ／ 無期限は upper を空欄で表記。基準日 2026-08-03。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="450" y="44" width="600" height="18" as="geometry" />
        </mxCell>

        <mxCell id="P-01" value="&lt;b&gt;person&lt;/b&gt;　識別子（全ロールが参照）&lt;br&gt;&lt;br&gt;person_id  group_joined_on&lt;br&gt;1          2020-04-01&lt;br&gt;2          2018-04-01&lt;br&gt;3          &lt;b&gt;2019-04-01&lt;/b&gt;　←転籍しても据え置き&lt;br&gt;4          2026-10-01　←入社前&lt;br&gt;5          2025-07-01　←外部人材" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="440" height="150" as="geometry" />
        </mxCell>

        <mxCell id="P-02" value="&lt;b&gt;person_name&lt;/b&gt;　氏名（&lt;b&gt;公開&lt;/b&gt;）&lt;br&gt;&lt;br&gt;person_id  full_name   full_name_kana&lt;br&gt;1          山田 花子   ヤマダ ハナコ&lt;br&gt;2          鈴木 一郎   スズキ イチロウ&lt;br&gt;3          田中 次郎   タナカ ジロウ&lt;br&gt;4          佐藤 三郎   サトウ サブロウ&lt;br&gt;5          高橋 四郎   タカハシ シロウ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="440" height="150" as="geometry" />
        </mxCell>

        <mxCell id="P-03" value="&lt;b&gt;person_demographics&lt;/b&gt;　（&lt;b&gt;非公開&lt;/b&gt;）&lt;br&gt;&lt;br&gt;person_id  gender  birth_date&lt;br&gt;1          F       1995-03-12&lt;br&gt;2          M       1988-07-01&lt;br&gt;3          M       1996-11-20&lt;br&gt;4          F       2004-01-15&lt;br&gt;5          M       1990-05-08&lt;br&gt;&lt;br&gt;&lt;b&gt;hrcore_analyst からは REVOKE 済み&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="980" y="80" width="460" height="150" as="geometry" />
        </mxCell>

        <mxCell id="P-04" value="&lt;b&gt;employment&lt;/b&gt;　雇用　←転籍・入社前・外部人材&lt;br&gt;&lt;br&gt;person  company  employee_no  account    employment_type  入社区分  通勤  届出  valid_period&lt;br&gt;1       CB       10001        hanako.y   regular          新卒      TKY   TKY   [2020-04-01, )&lt;br&gt;2       CB       10002        ichiro.s   regular          中途      OSK   OSK   [2018-04-01, )&lt;br&gt;3       CB       10003        jiro.t     regular          新卒      TKY   TKY   [2019-04-01, 2025-04-01)&lt;br&gt;3       CBUS     US-0007      jiro.t     regular          &lt;b&gt;転籍&lt;/b&gt;      -     -     [2025-04-01, )&lt;br&gt;4       CB       10004        saburo.s   regular          新卒      TKY   TKY   &lt;b&gt;[2026-10-01, )&lt;/b&gt;　←入社前&lt;br&gt;5       CB       EX-0012      shiro.t    &lt;b&gt;outsourced&lt;/b&gt;       -         TKY   TKY   [2025-07-01, )　←業務委託&lt;br&gt;&lt;br&gt;・person 3 は 2025-03-31 付で CB を退職し CBUS へ転籍。&lt;b&gt;person_id は 3 のまま不変&lt;/b&gt;。半開区間なので前雇用の upper と&lt;br&gt;　新雇用の lower が同じ 2025-04-01 で隙間なく接続し、EXCLUDE (person_id, period) にも違反しない&lt;br&gt;・person 4 は雇用開始日が未来日 → &lt;b&gt;現行の「入社前」に相当&lt;/b&gt;。employment_status の行は作らない&lt;br&gt;・person 5 は業務委託（is_employee = false）→ 稼働人員には数えるが&lt;b&gt;社員数・開示指標の分母には入れない&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="1380" height="240" as="geometry" />
        </mxCell>

        <mxCell id="P-05" value="&lt;b&gt;employment_status&lt;/b&gt;　在籍状況　←休職・転籍&lt;br&gt;&lt;br&gt;person  status_code  event_type  reason      valid_period&lt;br&gt;1       active       入社        新卒        [2020-04-01, 2026-06-01)&lt;br&gt;1       &lt;b&gt;leave&lt;/b&gt;        休職        育児休業    [2026-06-01, 2026-12-01)　←&lt;b&gt;基準日は休職中&lt;/b&gt;&lt;br&gt;1       active       復職        -           [2026-12-01, )　←未来日の復職&lt;br&gt;2       active       入社        中途        [2018-04-01, )&lt;br&gt;3       active       入社        新卒        [2019-04-01, 2025-04-01)&lt;br&gt;3       active       入社        &lt;b&gt;転籍&lt;/b&gt;        [2025-04-01, )&lt;br&gt;5       active       入社        -           [2025-07-01, )&lt;br&gt;&lt;br&gt;・person 4（入社前）の行は&lt;b&gt;存在しない&lt;/b&gt;。入社日に active を入れる&lt;br&gt;・離職率は event_type = '退職' ＋ reason で算出する&lt;br&gt;・男性育児休業取得率は gender × reason = '育児休業' で算出できる（3.5）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="690" height="255" as="geometry" />
        </mxCell>

        <mxCell id="P-06" value="&lt;b&gt;employment_condition&lt;/b&gt;　労働条件　←FTE の基礎&lt;br&gt;&lt;br&gt;person  所定  週日数  固定残業  労働時間管理  給与体系  valid_period&lt;br&gt;1       8.00  5.0     20.0      通常          月給      [2020-04-01, 2024-04-01)&lt;br&gt;1       &lt;b&gt;6.00&lt;/b&gt;  5.0     0.0       通常          月給      [2024-04-01, )　←&lt;b&gt;時短&lt;/b&gt;&lt;br&gt;2       8.00  &lt;b&gt;4.0&lt;/b&gt;     20.0      &lt;b&gt;裁量労働&lt;/b&gt;      年俸      [2018-04-01, )　←&lt;b&gt;週4&lt;/b&gt;&lt;br&gt;3       8.00  5.0     20.0      通常          月給      [2019-04-01, )&lt;br&gt;5       8.00  3.0     0.0       -             &lt;b&gt;時給&lt;/b&gt;      [2025-07-01, )&lt;br&gt;&lt;br&gt;・&lt;b&gt;雇用の期間とは独立して切れる&lt;/b&gt;（person 1 は時短化しても employment は1行のまま）&lt;br&gt;・FTE = 所定 × 週日数 ÷ company.standard_weekly_hours（CB = 40.0）&lt;br&gt;　person 1 → 6.00 × 5.0 / 40 = &lt;b&gt;0.750&lt;/b&gt;　person 2 → 8.00 × 4.0 / 40 = &lt;b&gt;0.800&lt;/b&gt;&lt;br&gt;・時給者（person 5）は所定が固定でない場合があり FTE は実態と乖離する" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="770" y="510" width="670" height="255" as="geometry" />
        </mxCell>

        <mxCell id="P-07" value="&lt;b&gt;マスタ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;employment_type&lt;/b&gt;　　　　　　　　&lt;b&gt;employment_status_type&lt;/b&gt;　　　&lt;b&gt;org_layer&lt;/b&gt;　　　　　　　　　　&lt;b&gt;position_grade&lt;/b&gt;&lt;br&gt;type_code   name    is_employee     status  name  is_active     layer_code   name    order  countable     grade_code       name          order&lt;br&gt;regular     正社員  &lt;b&gt;true&lt;/b&gt;            active  在籍  &lt;b&gt;true&lt;/b&gt;          company      会社    0      &lt;b&gt;false&lt;/b&gt;         exec             役員          0&lt;br&gt;contract    契約社員 true            leave   休職  false         honbu        本部    1      true          honbu_cho        本部長        1&lt;br&gt;outsourced  業務委託 &lt;b&gt;false&lt;/b&gt;           retired 退職  false         fuku_honbu   副本部  2      true          fuku_honbu_cho   副本部長      2&lt;br&gt;dispatched  派遣    &lt;b&gt;false&lt;/b&gt;                                        bu           部      3      true          bu_cho           部長          3&lt;br&gt;                                                                          fuku_bu      副部    4      true          fuku_bu_cho      副部長        4&lt;br&gt;&lt;b&gt;company&lt;/b&gt;（FTE の分母）                                                 team         チーム  5      true          team_leader      チームリーダー 5&lt;br&gt;code  name                standard_weekly_hours&lt;br&gt;CB    サイボウズ株式会社  40.0&lt;br&gt;CBUS  Cybozu US, Inc.     &lt;i&gt;要確認&lt;/i&gt;&lt;br&gt;CBVN  Cybozu Vietnam      &lt;i&gt;要確認&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#F1F8E9;strokeColor=#7CB342;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="785" width="1380" height="215" as="geometry" />
        </mxCell>

        <mxCell id="p-note" value="&lt;b&gt;含めた検証ケース&lt;/b&gt;：転籍（person 3、person_id 不変・グループ通算入社日は据え置き）／休職（person 1、育休。配属は切らない）／未来日の復職／&lt;b&gt;入社前&lt;/b&gt;（person 4、employment_status の行なし）／&lt;b&gt;外部人材&lt;/b&gt;（person 5、is_employee = false）／時短勤務（person 1）／週4勤務・裁量労働（person 2）／時給（person 5）／非公開属性の分離（person_demographics）&#10;&lt;b&gt;対象外&lt;/b&gt;：kintone 側が持つ情報（兼務工数・マネジメント役割・緊急連絡先）。給与額は HRCore に持たない（給与体系の分類のみ）。　　&lt;b&gt;要確認事項&lt;/b&gt;：docs/TODO.md" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;" vertex="1" parent="1">
          <mxGeometry x="60" y="1015" width="1380" height="75" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hrcore-sample-org-v3" name="3. サンプルレコード（組織・横断）">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="o-title" value="HRCore 実例データ — ③ サンプルレコード（組織・役職・配属・横断軸）" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A2538;" vertex="1" parent="1">
          <mxGeometry x="400" y="14" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="o-sub" value="期間はすべて半開区間 [) ／ 無期限は upper を空欄で表記。基準日 2026-08-03。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="450" y="44" width="600" height="18" as="geometry" />
        </mxCell>

        <mxCell id="O-01" value="&lt;b&gt;org_unit&lt;/b&gt;　組織　←会社相当組織・改称&lt;br&gt;&lt;br&gt;org_code   org_name              org_name_en        company  layer_code  valid_period&lt;br&gt;&lt;b&gt;CB-ROOT&lt;/b&gt;    サイボウズ株式会社    Cybozu, Inc.       CB       &lt;b&gt;company&lt;/b&gt;     [2000-08-01, )　←役員設置用&lt;br&gt;&lt;b&gt;CBUS-ROOT&lt;/b&gt;  Cybozu US, Inc.       Cybozu US, Inc.    CBUS     &lt;b&gt;company&lt;/b&gt;     [2014-04-01, )　←配下なし&lt;br&gt;HR         人事本部              HR Division        CB       honbu       [2015-04-01, )&lt;br&gt;HRINF      人事インフラ部        HR Infrastructure  CB       bu          [2022-04-01, )&lt;br&gt;HRANL      HR数値分析チーム      HR Analytics       CB       team        [2024-04-01, )&lt;br&gt;EP         EP事業本部            EP Division        CB       honbu       [2016-04-01, 2026-04-01)　←改称前&lt;br&gt;EP         営業本部              Sales Division     CB       honbu       [2026-04-01, )　　　　　　←改称後&lt;br&gt;EPF        EP事業副部            EP Sub Division    CB       fuku_honbu  [2016-04-01, )&lt;br&gt;EPB        EP事業部              EP Department      CB       bu          [2016-04-01, )&lt;br&gt;GLB        グローバル事業本部    Global Division    CB       honbu       [2014-04-01, )&lt;br&gt;USOPS      Cybozu US             Cybozu US          CBUS     bu          [2014-04-01, )&lt;br&gt;VNOPS      Cybozu Vietnam        Cybozu Vietnam     CBVN     honbu       [2015-04-01, )&lt;br&gt;&lt;br&gt;&lt;b&gt;EP を「EP事業本部 → 営業本部」に改称しても増える行は org_unit の1行だけ。&lt;/b&gt;配下の EPF / EPB の行は一切増えない&lt;br&gt;（5列フルパス案なら全子孫の履歴行が増えていた）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="900" height="300" as="geometry" />
        </mxCell>

        <mxCell id="O-02" value="&lt;b&gt;org_hierarchy&lt;/b&gt;　←未来日の再編&lt;br&gt;&lt;br&gt;org_code    parent       valid_period&lt;br&gt;CB-ROOT     NULL         [2000-08-01, )　←ルート&lt;br&gt;CBUS-ROOT   NULL         [2014-04-01, )　←ルート&lt;br&gt;HR          &lt;b&gt;CB-ROOT&lt;/b&gt;      [2015-04-01, )&lt;br&gt;HRINF       HR           [2022-04-01, 2026-10-01)&lt;br&gt;HRINF       GLB          [2026-10-01, )　←&lt;b&gt;未来日予約&lt;/b&gt;&lt;br&gt;HRANL       HRINF        [2024-04-01, )&lt;br&gt;EP          &lt;b&gt;CB-ROOT&lt;/b&gt;      [2016-04-01, )&lt;br&gt;EPF         EP           [2016-04-01, )&lt;br&gt;EPB         EPF          [2016-04-01, )&lt;br&gt;GLB         &lt;b&gt;CB-ROOT&lt;/b&gt;      [2014-04-01, )&lt;br&gt;USOPS       GLB          [2014-04-01, )　←会社跨ぎ&lt;br&gt;VNOPS       NULL         [2015-04-01, )　←独立ルート&lt;br&gt;&lt;br&gt;&lt;i&gt;本部は会社相当組織の配下に入るため、&lt;br&gt;深さが v2.0 より 1 増える（上限 6）&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="980" y="80" width="460" height="300" as="geometry" />
        </mxCell>

        <mxCell id="O-03" value="&lt;b&gt;position&lt;/b&gt; / &lt;b&gt;position_holder&lt;/b&gt;　←役員・同一組織に階層の違う役職&lt;br&gt;&lt;br&gt;position_id  org_code   position_name        grade_code       valid_period&lt;br&gt;1            &lt;b&gt;CB-ROOT&lt;/b&gt;    代表取締役社長       &lt;b&gt;exec&lt;/b&gt;             [2000-08-01, )　←役員&lt;br&gt;2            HR         人事本部長           honbu_cho        [2015-04-01, )&lt;br&gt;3            HR         人事副本部長         &lt;b&gt;fuku_honbu_cho&lt;/b&gt;   [2024-04-01, )　←&lt;b&gt;同じ HR に階層の違う役職&lt;/b&gt;&lt;br&gt;4            HRINF      人事インフラ部長     bu_cho           [2022-04-01, )&lt;br&gt;&lt;br&gt;person  position_id  valid_period&lt;br&gt;2       2            [2018-04-01, )&lt;br&gt;1       4            [2022-04-01, )&lt;br&gt;&lt;br&gt;・役員は会社相当組織（CB-ROOT）に設置する。position.org_code が NOT NULL のため器が必要&lt;br&gt;・&lt;b&gt;副本部長は「副本部という組織の長」ではなく「本部の No.2」&lt;/b&gt;→ 同じ HR に honbu_cho と fuku_honbu_cho が並ぶ&lt;br&gt;　→ 設置組織の layer_order と grade_order が 1:1 にならないため、対応を検証する制約は張らない" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="900" height="255" as="geometry" />
        </mxCell>

        <mxCell id="O-04" value="&lt;b&gt;job_function&lt;/b&gt; / &lt;b&gt;person_job_function&lt;/b&gt;&lt;br&gt;&lt;i&gt;現行の「タグ一覧」。マトリクスの横軸&lt;/i&gt;&lt;br&gt;&lt;br&gt;fn_code  fn_name                external_code  valid_period&lt;br&gt;FE       フロントエンドエンジニア  B-2001         [2020-04-01, )&lt;br&gt;BE       バックエンドエンジニア    B-2002         [2020-04-01, )&lt;br&gt;QA       QAエンジニア              B-2003         [2020-04-01, )&lt;br&gt;PDM      PDマネジメント            B-2004         [2020-04-01, )&lt;br&gt;&lt;br&gt;person  fn_code  role      valid_period&lt;br&gt;3       FE       member    [2019-04-01, )&lt;br&gt;3       &lt;b&gt;QA&lt;/b&gt;       member    [2024-04-01, )　←&lt;b&gt;複数職能&lt;/b&gt;&lt;br&gt;5       BE       member    [2025-07-01, )&lt;br&gt;&lt;br&gt;・external_code は bozuman 側の組織コード&lt;br&gt;　（bozuman では職能が組織として扱われている）&lt;br&gt;・person 3 は FE 兼 QA → &lt;b&gt;職能で数えると重複計上される&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="980" y="400" width="460" height="255" as="geometry" />
        </mxCell>

        <mxCell id="O-05" value="&lt;b&gt;assignment&lt;/b&gt;（案A）　←兼務・未来日異動・休職中も切らない・外部人材の配属&lt;br&gt;&lt;br&gt;person  org_code  is_primary  event_type  reason        valid_period&lt;br&gt;1       HRINF     true        初回配属    -             [2022-04-01, )　←&lt;b&gt;休職中も切らない&lt;/b&gt;&lt;br&gt;1       HRANL     false       兼務発令    分析体制強化  [2024-04-01, )　←&lt;b&gt;兼務（同時2組織）&lt;/b&gt;&lt;br&gt;2       HR        true        初回配属    -             [2018-04-01, 2026-09-01)&lt;br&gt;2       HRINF     true        &lt;b&gt;異動&lt;/b&gt;        組織再編      [2026-09-01, )　←&lt;b&gt;未来日の異動予約&lt;/b&gt;&lt;br&gt;3       EPB       true        初回配属    -             [2019-04-01, 2025-04-01)&lt;br&gt;3       USOPS     true        異動        転籍          [2025-04-01, )&lt;br&gt;5       EPB       true        契約開始    -             [2025-07-01, )　←外部人材も配属を持つ&lt;br&gt;&lt;br&gt;・EXCLUDE は (person_id, org_code, period) なので&lt;b&gt;別組織なら同時配属が通る&lt;/b&gt;。同じ HRINF に期間の重なる行を入れた場合だけ弾かれる&lt;br&gt;・&lt;b&gt;person 1 は休職中（2026-06-01〜）でも配属行はそのまま。&lt;/b&gt;復職時に行を足す必要がない&lt;br&gt;・person 4（入社前）の配属行は入社日 2026-10-01 開始で先に登録できる（この例では未登録）&lt;br&gt;・兼務工数（HRINF 70% / HRANL 30% 等）は kintone 側で持つ&lt;br&gt;&lt;br&gt;&lt;b&gt;working_group / working_group_member&lt;/b&gt;　　wg_code: WG-DEI（DEI推進WG・全社）/ WG-AI（生成AI活用WG・技術）&lt;br&gt;person 2 → WG-DEI &lt;b&gt;manager&lt;/b&gt;　person 1 → WG-DEI member ＋ WG-AI member（&lt;b&gt;複数 WG 同時参加&lt;/b&gt;）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E8EAF6;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="675" width="1380" height="325" as="geometry" />
        </mxCell>

        <mxCell id="o-note" value="&lt;b&gt;含めた検証ケース&lt;/b&gt;：会社相当組織（CB-ROOT / CBUS-ROOT）／役員の設置／同一組織に階層の違う役職（本部長＋副本部長）／改称（配下の履歴行が増えない）／未来日の組織再編／会社跨ぎ／独立ルート／兼務（同時2組織）／未来日の異動／休職中も配属を切らない／外部人材の配属／&lt;b&gt;複数職能（FE 兼 QA）&lt;/b&gt;／複数 WG 同時参加／職能への外部システムコード対応&#10;&lt;b&gt;要確認事項&lt;/b&gt;：docs/TODO.md（役員が現行の役職一覧にあるか、同一役職に複数人が就くか 等）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;" vertex="1" parent="1">
          <mxGeometry x="60" y="1015" width="1380" height="75" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hrcore-sample-query-v3" name="4. as-of・集計軸">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="q-title" value="HRCore 実例データ — ④ as-of クエリ・フルパス展開・集計軸" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A2538;" vertex="1" parent="1">
          <mxGeometry x="450" y="14" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="q-sub" value="②③のサンプルレコードに対してクエリを投げた結果。基準日 2026-08-03。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="450" y="44" width="600" height="18" as="geometry" />
        </mxCell>

        <mxCell id="Q-01" value="&lt;b&gt;as-of クエリ：基準日を変えて同じ SQL を投げる&lt;/b&gt;&lt;br&gt;&lt;br&gt;SELECT * FROM assignment WHERE valid_period @&amp;gt; DATE '____';&lt;br&gt;&lt;br&gt;&lt;b&gt;2026-08-03（今日）&lt;/b&gt;&lt;br&gt;　person 2 の主務 = HR（人事本部）&lt;br&gt;　person 1 = HRINF 主務 ＋ HRANL 兼務（ただし&lt;b&gt;休職中&lt;/b&gt;）&lt;br&gt;　person 4 は employment が未来 → 現在断面に&lt;b&gt;出ない&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2026-09-01&lt;/b&gt;　person 2 の主務 = HRINF に切り替わる&lt;br&gt;　→ 異動が自動的に反映される。&lt;b&gt;バッチ実行なし&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2026-10-01&lt;/b&gt;　配属行は 9/1 と同じだが、HRINF の親が GLB に変わる&lt;br&gt;　→ person 1・2 の所属本部が 人事本部 → グローバル事業本部&lt;br&gt;　→ &lt;b&gt;配属を1行も触らずに本部別集計が変わる&lt;/b&gt;&lt;br&gt;　→ 同日 person 4 が入社 → employee_current に現れる&lt;br&gt;&lt;br&gt;&lt;b&gt;2026-12-01&lt;/b&gt;　person 1 が復職 → is_active が true に戻る&lt;br&gt;　→ &lt;b&gt;assignment は一度も変更していない&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="680" height="290" as="geometry" />
        </mxCell>

        <mxCell id="Q-02" value="&lt;b&gt;「人員数」は数え方で値が変わる（CB / 2026-08-03）&lt;/b&gt;&lt;br&gt;&lt;br&gt;対象者: person 1（休職・正社員）, 2（在籍・正社員）, 5（在籍・業務委託）&lt;br&gt;　　　　person 3 は CBUS、person 4 は入社前（未来）&lt;br&gt;&lt;br&gt;&lt;b&gt;① 社員数&lt;/b&gt;　is_employee ＝ true かつ is_active ＝ true&lt;br&gt;　→ person 2 のみ　＝ &lt;b&gt;1名&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;② 稼働人員数&lt;/b&gt;　is_active ＝ true（外部人材を含む）&lt;br&gt;　→ person 2, 5　＝ &lt;b&gt;2名&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;③ 在籍者（雇用がある人）&lt;/b&gt;　休職者を含む&lt;br&gt;　→ person 1, 2, 5　＝ &lt;b&gt;3名&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;④ 入社前を含む&lt;/b&gt;　employee_pending を足す&lt;br&gt;　→ ＋ person 4　＝ &lt;b&gt;4名&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;⑤ FTE&lt;/b&gt;（社員・主務ベース）　person 2 = 8.00×4.0/40&lt;br&gt;　→ &lt;b&gt;0.800 FTE&lt;/b&gt;（頭数 1名 に対して）&lt;br&gt;&lt;br&gt;&lt;b&gt;⚠ 同じ「CB の人員数」が 1 / 2 / 3 / 4 / 0.8 に割れる。&lt;/b&gt;&lt;br&gt;レポートでは毎回どの数え方かを明示する" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="680" height="290" as="geometry" />
        </mxCell>

        <mxCell id="Q-03" value="&lt;b&gt;org_full_path('2026-08-03') の出力&lt;/b&gt;　← 現行 kintone の見え方を再現できるかの検証&lt;br&gt;&lt;br&gt;org_code   depth layer      level1              level2      level3          level4 level5&lt;br&gt;CB-ROOT    1     &lt;b&gt;company&lt;/b&gt;    &lt;b&gt;NULL&lt;/b&gt;                NULL        NULL            NULL   NULL&lt;br&gt;HR         2     honbu      人事本部            NULL        NULL            NULL   NULL&lt;br&gt;HRINF      3     bu         人事本部            &lt;b&gt;NULL&lt;/b&gt;        人事インフラ部  NULL   NULL&lt;br&gt;HRANL      4     team       人事本部            &lt;b&gt;NULL&lt;/b&gt;        人事インフラ部  &lt;b&gt;NULL&lt;/b&gt;   HR数値分析チーム&lt;br&gt;EP         2     honbu      営業本部            NULL        NULL            NULL   NULL&lt;br&gt;EPF        3     fuku_honbu 営業本部            EP事業副部  NULL            NULL   NULL&lt;br&gt;EPB        4     bu         営業本部            EP事業副部  EP事業部        NULL   NULL&lt;br&gt;USOPS      3     bu         グローバル事業本部  &lt;b&gt;NULL&lt;/b&gt;        Cybozu US       NULL   NULL&lt;br&gt;VNOPS      1     honbu      Cybozu Vietnam      NULL        NULL            NULL   NULL&lt;br&gt;&lt;br&gt;&lt;b&gt;列位置は depth ではなく layer_order で決まる。&lt;/b&gt;HRANL は depth 4 だが level5 に入り、level2 と level4 は NULL のまま残る。&lt;br&gt;これが現行 kintone の非正規化フルパス（level2 IS NULL AND level3 IS NOT NULL）と一致する → 既存アプリの WHERE level3 = 'EP事業部' がそのまま動く。&lt;br&gt;&lt;b&gt;会社相当組織（layer_order = 0）は level1〜level5 のどこにも入らない&lt;/b&gt;ため、ツリーに会社を追加しても現行の見え方は変わらない（depth だけ +1）。&lt;br&gt;※ EP の org_name は 2026-04-01 以降「営業本部」。基準日で自動的に切り替わっている。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="1380" height="290" as="geometry" />
        </mxCell>

        <mxCell id="Q-04" value="&lt;b&gt;集計軸は4本あり、互いに一致しない（2026-08-03）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;① 会社&lt;/b&gt;　CB = CB-ROOT/HR/HRINF/HRANL/EP/EPF/EPB/GLB（8）　CBUS = CBUS-ROOT/USOPS（2）　CBVN = VNOPS（1）&lt;br&gt;&lt;br&gt;&lt;b&gt;② 階層区分 layer_order&lt;/b&gt;　← 正しい軸。is_countable = false（会社相当組織）を除外する&lt;br&gt;　「部」レベル bu(3) = HRINF, EPB, USOPS　→ &lt;b&gt;3組織&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;③ ツリーの深さ depth&lt;/b&gt;　← 使ってはいけない&lt;br&gt;　depth = 4 = HRANL, EPB　→ &lt;b&gt;2組織&lt;/b&gt;　※ depth で「部レベル」を数えると HRINF・USOPS（depth 3）が漏れ、HRANL（チーム）が混ざる&lt;br&gt;&lt;br&gt;&lt;b&gt;④ 職能 fn_code&lt;/b&gt;　← 組織ツリーと直交する横軸&lt;br&gt;　FE = person 3　BE = person 5　QA = person 3　→ 職能の合計は &lt;b&gt;3件&lt;/b&gt; だが実人数は &lt;b&gt;2名&lt;/b&gt;（person 3 が FE 兼 QA のため&lt;b&gt;重複計上&lt;/b&gt;）&lt;br&gt;&lt;br&gt;&lt;b&gt;マトリクス集計の例&lt;/b&gt;　「EPB（EP事業部）の人員」= person 5（1名）　「全社のバックエンドエンジニア」= person 5（1名）&lt;br&gt;　→ 組織軸と職能軸は別の切り口であり、どちらも必要。組織を跨いだ職能の把握が現行のタグ管理の目的" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#FFF8E1;strokeColor=#FFB300;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1380" height="230" as="geometry" />
        </mxCell>

        <mxCell id="Q-05" value="&lt;b&gt;ロール分離の確認（PoC 検証項目 11）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;hrcore_analyst&lt;/b&gt; で実行&lt;br&gt;　SELECT * FROM person_demographics;　→ &lt;b&gt;permission denied&lt;/b&gt;（REVOKE 済み）&lt;br&gt;　SELECT full_name FROM employee_current;　→ &lt;b&gt;読める&lt;/b&gt;（ビューが定義者権限で動くため）&lt;br&gt;&lt;br&gt;&lt;b&gt;hrcore_hr&lt;/b&gt; で実行&lt;br&gt;　SELECT gender, birth_date FROM person_demographics;　→ 読める（開示指標の算出用）&lt;br&gt;&lt;br&gt;&lt;b&gt;hrcore_kintone&lt;/b&gt; で実行&lt;br&gt;　SELECT * FROM employee_current;　→ 読める　／　SELECT * FROM employment;　→ &lt;b&gt;permission denied&lt;/b&gt;（公開ビューのみ）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontFamily=Courier New;fontColor=#333333;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="950" width="1380" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
