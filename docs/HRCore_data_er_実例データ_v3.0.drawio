        <mxCell id="t-title" value="HRCore 実例データ — ① 組織ツリー（2026-08-03 時点）" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A2538;" vertex="1" parent="1">
