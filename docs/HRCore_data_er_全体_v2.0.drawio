        <mxCell id="LG-2" value="時系列を持たないマスタ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F1F8E9;strokeColor=#7CB342;" vertex="1" parent="1"><mxGeometry x="380" y="850" width="180" height="26" as="geometry" /></mxCell>
        <mxCell id="LG-3" value="案B（PoC 並行検証）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF3E0;strokeColor=#FB8C00;" vertex="1" parent="1"><mxGeometry x="570" y="850" width="160" height="26" as="geometry" /></mxCell>
        <mxCell id="LG-4" value="監査" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F3E5F5;strokeColor=#8E24AA;" vertex="1" parent="1"><mxGeometry x="740" y="850" width="80" height="26" as="geometry" /></mxCell>
        <mxCell id="LG-5" value="ビュー・関数" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E0F7FA;strokeColor=#00838F;" vertex="1" parent="1"><mxGeometry x="830" y="850" width="120" height="26" as="geometry" /></mxCell>
        <mxCell id="LG-6" value="—|&lt; FK 制約あり（実線）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#607D8B;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="960" y="850" width="180" height="26" as="geometry" /></mxCell>
        <mxCell id="LG-7" value="⇠ 論理参照（破線 / FK なし）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF8E1;strokeColor=#F57C00;fontColor=#E65100;dashed=1;" vertex="1" parent="1"><mxGeometry x="1150" y="850" width="220" height="26" as="geometry" /></mxCell>

        <mxCell id="NOTE" value="&lt;b&gt;Scope&lt;/b&gt;：HRCore が持つ 13 エンティティ ＋ マスタ3 ＋ 案B検証用1 ＋ 監査1 ＋ kintone 公開面。属性と関連に絞った L2 の図。&#10;&lt;b&gt;対象外&lt;/b&gt;：kintone 側が持つ情報（非公開の個人情報・兼務工数・マネジメント役割）／API 層・Agent 構成（SPEC.md 1章）／制約の完全な定義・設計判断の根拠（SPEC.md 4章、db/schema.sql）／実例データ（&lt;b&gt;HRCore_data_er_実例データ_v2.0.drawio&lt;/b&gt;）&#10;&lt;b&gt;破線の意味&lt;/b&gt;：org_code / wg_code への参照は FK 制約を張れない。org_unit・working_group は期間ごとに複数行を持ちコードが一意でないため（PK がない）。参照整合性はアプリ層と制約トリガで担保する。&#10;&lt;b&gt;v2.0 変更点&lt;/b&gt;：現行 kintone 項目の棚卸し（tmp/fields.tsv）を反映。employment_status / working_group / working_group_member / org_external_code / employment_status_type / position_grade を追加。person に氏名・カナ・グループ通算入社日、employment に入社区分・アカウント名・届出拠点、assignment に異動理由、各マスタに英語名を追加。&#10;&lt;b&gt;入力ソース&lt;/b&gt;：db/schema.sql（スキーマの単一ソース）／docs/SPEC.md 3-5章／tmp/fields.tsv" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#444444;spacingLeft=8;spacingTop=6;strokeColor=#D0D0D0;fillColor=#FAFAFA;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="1380" height="105" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
